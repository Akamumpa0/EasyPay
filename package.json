{
  "name": "easypay",
  "version": "1.0.0",
  "description": "Multi-provider payment orchestration API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:seed": "tsc -p prisma/tsconfig.seed.json && node dist-seed/seed.js",
